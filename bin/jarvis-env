#!/bin/bash
# Shared environment for Jarvis scripts. Sourced, not executed.

: "${JARVIS_HOME:=${JARVIS_HOME:-$HOME/.local/share/jarvis}}"
: "${JARVIS_CONFIG_DIR:=${JARVIS_CONFIG_DIR:-$HOME/.config/jarvis}}"
# Runtime files live under $XDG_RUNTIME_DIR (private, user-owned, cleared on reboot — logind
# guarantees it) or an explicit $JARVIS_CACHE. Never a shared /tmp: another local user could
# pre-create the directory and plant symlinks for our writes to follow.
if [ -z "${JARVIS_CACHE:-}" ]; then
  if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ ! -L "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ]; then
    JARVIS_CACHE="$XDG_RUNTIME_DIR/jarvis-$UID"
  else
    echo "jarvis: no secure runtime directory — XDG_RUNTIME_DIR is unset or not a directory you own; set JARVIS_CACHE to a private one" >&2
    exit 1
  fi
fi
: "${JARVIS_VENV:=$JARVIS_HOME/venv}"
: "${JARVIS_VOICES:=$JARVIS_HOME/voices}"
: "${JARVIS_LOG:=$JARVIS_CACHE/jarvis.log}"

# ---- defaults (precedence: config.sh > environment > these) ----
: "${JARVIS_ENGINE:=auto}"                       # auto | edge | piper | espeak
: "${JARVIS_EDGE_VOICE:=en-GB-RyanNeural}"       # `edge-tts --list-voices` for more
: "${JARVIS_EDGE_RATE:=+5%}"
: "${JARVIS_PIPER_VOICE:=en_GB-alan-medium}"     # https://rhasspy.github.io/piper-samples/
: "${JARVIS_PIPER_LENGTH:=1.0}"                  # <1 faster, >1 slower
: "${JARVIS_EDGE_TIMEOUT:=8}"                      # seconds before falling back to Piper
: "${JARVIS_SAY_MAX:=3000}"                       # longest line spoken, in characters (~3 min); the rest is cut
: "${JARVIS_SUMMARY:=haiku}"                     # haiku | heuristic | full
: "${JARVIS_SUMMARY_MODEL:=haiku}"
: "${JARVIS_SHORT_MSG_CHARS:=220}"                 # replies shorter than this are read as-is
: "${JARVIS_NARRATE:=1}"                           # narrate tool use
: "${JARVIS_NARRATE_TOOLS:=Bash Edit Write MultiEdit NotebookEdit Agent WebFetch WebSearch}"
: "${JARVIS_NARRATE_COOLDOWN:=4}"                  # seconds; drop repeats of the same line
: "${JARVIS_GREET:=1}"                             # greet on session startup
: "${JARVIS_IDLE_ALERT:=1}"                        # speak on idle_prompt notifications
: "${JARVIS_ADDRESS:=sir}"                       # how Jarvis addresses you
: "${JARVIS_PLAYER:=}"                           # auto-detect: mpv | ffplay | pw-play | paplay

: "${JARVIS_WAKE:=1}"                           # "Hey Jarvis" wake word (jarvis listen enable)
: "${JARVIS_WAKE_THRESHOLD:=0.5}"               # 0..1; lower = more sensitive, more false wakes
: "${JARVIS_WAKE_COOLDOWN:=3}"                  # seconds to ignore repeat wakes
: "${JARVIS_WAKE_CHIME:=1}"                     # play a short chime on wake
: "${JARVIS_WAKE_ACTION:=dictate}"              # dictate | hush  (what "Hey Jarvis" does)
: "${JARVIS_DICTATE_CMD:=voxtype record toggle}" # started after hush by `jarvis dictate`
: "${JARVIS_DICTATE_STOP_CMD:=voxtype record stop}" # run by the silence stop and "Hey Jarvis, stop"
: "${JARVIS_DICTATE_CANCEL_CMD:=voxtype record cancel}" # run when nothing was said after the wake word
: "${JARVIS_STOP_GRACE:=1}"                     # seconds after the stop wake before the recording ends
: "${JARVIS_SILENCE_SECS:=1.5}"                 # end a wake-word dictation after this much silence (0 = only the stop word / key)
: "${JARVIS_VAD_THRESHOLD:=0.5}"                # Silero speech probability that counts as talking
: "${JARVIS_SPEECH_MIN_SECS:=0.3}"              # continuous speech needed before silence can end the dictation (ignores the chime)
: "${JARVIS_MAX_WAIT_SECS:=15}"                 # cancel the dictation if nothing is said this long after the wake word
: "${JARVIS_START_WORDS:=}"                     # regex; words stripped from the start of a dictation (default in jarvis-dictation-filter)
: "${JARVIS_STOP_WORDS:=}"                      # regex; words stripped after the trailing "Hey Jarvis"

: "${JARVIS_VIZ:=1}"                            # on-screen visualizer while speaking (needs quickshell)
: "${JARVIS_VIZ_ACCENT:=}"                      # defaults come from the active Omarchy theme
: "${JARVIS_VIZ_GLOW:=}"
: "${JARVIS_VIZ_FG:=}"
: "${JARVIS_VIZ_BG:=}"
: "${JARVIS_VIZ_FONT:=}"

[ -f "$JARVIS_CONFIG_DIR/config.sh" ] && . "$JARVIS_CONFIG_DIR/config.sh"

# Create the runtime directory privately and refuse anything that is not our own 0700 directory
# (a symlink, someone else's directory, a file), so no write below it can be redirected.
[ -e "$JARVIS_CACHE" ] || mkdir -m 0700 -p "$JARVIS_CACHE" 2>/dev/null
if [ -L "$JARVIS_CACHE" ] || [ ! -d "$JARVIS_CACHE" ] || [ ! -O "$JARVIS_CACHE" ]; then
  echo "jarvis: refusing runtime directory $JARVIS_CACHE — not a directory you own" >&2
  exit 1
fi
chmod 0700 "$JARVIS_CACHE"

# Runtime files shared with `jarvis hush`, the wake daemon and the Omarchy bar widget.
JARVIS_STATE="$JARVIS_CACHE/state"          # idle | speaking | listening | muted | off
JARVIS_PLAYER_PID="$JARVIS_CACHE/player.pid"
JARVIS_HUSH_EPOCH="$JARVIS_CACHE/hush-epoch" # bumped by hush; queued speech from before it is dropped

jarvis_log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >> "$JARVIS_LOG"; }
jarvis_muted() { [ -f "$JARVIS_CONFIG_DIR/muted" ]; }
jarvis_state() { # jarvis_state <name>  — atomic write so the bar widget never reads a torn file
  printf '%s\n' "$1" > "$JARVIS_STATE.tmp" && mv -f "$JARVIS_STATE.tmp" "$JARVIS_STATE"
}
jarvis_epoch() { cat "$JARVIS_HUSH_EPOCH" 2>/dev/null || echo 0; }
